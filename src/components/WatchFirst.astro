---
import { PINNED_VIDEOS, getLatestLongFormVideo } from '../lib/youtube';

// Baked in at build time so the slot is never empty. A small script below
// refreshes it from /api/latest-video (cached hourly) after the page loads.
const latest = await getLatestLongFormVideo();

const videos = [
  ...PINNED_VIDEOS.map(v => ({ ...v, slot: 'pinned' })),
  { ...latest, label: 'Latest video', slot: 'latest' },
];

const thumb = (id: string) => `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
---

<section id="watch-first" class="pt-14 pb-4 max-w-6xl mx-auto px-6" aria-labelledby="watch-first-heading">
  <div class="flex items-center gap-3 mb-6">
    <div class="h-px w-10 bg-primary/40 flex-shrink-0"></div>
    <span class="text-sm font-medium tracking-widest uppercase text-primary/70">On YouTube</span>
  </div>
  <h2 id="watch-first-heading" class="font-display text-3xl text-dark mb-10">Watch these first</h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {videos.map(video => (
      <article
        class="wf-card rounded-2xl border border-dark/8 bg-white/60 p-3 flex flex-col gap-4 shadow-sm hover:border-primary/25 hover:shadow-md hover:shadow-primary/8 transition-all duration-300"
        data-video-id={video.id}
        data-slot={video.slot}
      >
        <div class="wf-media relative aspect-video rounded-xl overflow-hidden bg-dark/5">
          <button
            type="button"
            class="wf-play group absolute inset-0 w-full h-full cursor-pointer rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-off-white"
            aria-label={`Play video: ${video.title}`}
          >
            <img
              class="wf-thumb w-full h-full object-cover"
              src={thumb(video.id)}
              alt={`Thumbnail for the YouTube video "${video.title}" by Dino Favara Jr.`}
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute inset-0 flex items-center justify-center bg-dark/0 group-hover:bg-dark/15 transition-colors duration-300" aria-hidden="true">
              <span class="flex items-center justify-center w-14 h-14 rounded-full bg-primary/90 text-off-white shadow-lg shadow-primary/30 group-hover:scale-110 group-hover:bg-primary transition-transform duration-200">
                <svg viewBox="0 0 24 24" class="w-6 h-6 ml-0.5" fill="currentColor"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.8-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z" /></svg>
              </span>
            </span>
          </button>
        </div>
        <div class="px-2 pb-2 flex flex-col gap-2">
          <span class={`self-start inline-block px-3 py-1 rounded-full text-xs font-medium tracking-wide ${video.slot === 'latest' ? 'bg-mint/20 text-dark/70' : 'bg-primary/10 text-primary'}`}>
            {video.label}
          </span>
          <h3 class="wf-title font-display text-xl leading-snug text-dark">{video.title}</h3>
        </div>
      </article>
    ))}
  </div>

  <div class="mt-6 text-center">
    <a
      href="https://www.youtube.com/@DinoFavaraJr"
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-medium text-primary/80 hover:text-primary transition-colors"
    >
      See all videos on YouTube &rarr;
    </a>
  </div>
</section>

<script>
  const root = document.getElementById('watch-first');

  // Some videos have no maxres thumbnail; YouTube then serves a 120px grey
  // placeholder, so drop to the always-present hqdefault.
  function fixThumb(img: HTMLImageElement, id: string) {
    const check = () => {
      if (img.naturalWidth > 0 && img.naturalWidth <= 120) {
        img.src = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
      }
    };
    img.addEventListener('error', () => { img.src = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`; }, { once: true });
    if (img.complete) check(); else img.addEventListener('load', check, { once: true });
  }

  function play(card: HTMLElement) {
    const id = card.dataset.videoId;
    const media = card.querySelector<HTMLElement>('.wf-media');
    const title = card.querySelector('.wf-title')?.textContent ?? 'YouTube video';
    if (!id || !media) return;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
    iframe.title = title;
    iframe.className = 'absolute inset-0 w-full h-full';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    media.replaceChildren(iframe);
    card.dataset.playing = 'true';
    iframe.focus();
  }

  if (root) {
    root.querySelectorAll<HTMLElement>('.wf-card').forEach(card => {
      const img = card.querySelector<HTMLImageElement>('.wf-thumb');
      if (img && card.dataset.videoId) fixThumb(img, card.dataset.videoId);
      card.querySelector('.wf-play')?.addEventListener('click', () => play(card));
    });

    // Refresh the "Latest video" slot if a newer upload went live after the build.
    const latest = root.querySelector<HTMLElement>('.wf-card[data-slot="latest"]');
    if (latest) {
      fetch('/api/latest-video')
        .then(r => (r.ok ? r.json() : null))
        .then((v: { id?: string; title?: string } | null) => {
          if (!v?.id || !v.title || v.id === latest.dataset.videoId || latest.dataset.playing) return;
          latest.dataset.videoId = v.id;
          const img = latest.querySelector<HTMLImageElement>('.wf-thumb');
          if (img) {
            img.src = `https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`;
            img.alt = `Thumbnail for the YouTube video "${v.title}" by Dino Favara Jr.`;
            fixThumb(img, v.id);
          }
          latest.querySelector('.wf-play')?.setAttribute('aria-label', `Play video: ${v.title}`);
          const t = latest.querySelector('.wf-title');
          if (t) t.textContent = v.title;
        })
        .catch(() => {});
    }
  }
</script>
