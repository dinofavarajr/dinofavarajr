---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import KitForm from '../components/KitForm.astro';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) =>
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const newsletterColors: Record<string, string> = {
  'The Yearbook': 'bg-primary/10 text-primary',
  'Short Form Secrets': 'bg-mint/20 text-dark/70',
  'General': 'bg-dark/8 text-dark/60',
};

const tagColors: Record<string, string> = {
  'Behind The Scenes':  'bg-green-100 text-green-700',
  'Educational':        'bg-purple-100 text-purple-700',
  'Actionable':         'bg-blue-100 text-blue-700',
  'Encouraging':        'bg-yellow-100 text-yellow-800',
  'Posting Strategies': 'bg-sky-100 text-sky-700',
  'Viral Growth':       'bg-amber-100 text-amber-700',
  'YouTube Shorts':     'bg-red-50 text-red-600',
  'Client Work':        'bg-orange-100 text-orange-700',
  'Instagram':          'bg-orange-50 text-orange-600',
  'TikTok':             'bg-gray-100 text-gray-600',
};
---

<Layout
  title="Writing | Dino Favara Jr."
  description="Essays, newsletters, and short-form ideas from Dino Favara Jr. Subscribe to The Yearbook or Short Form Secrets."
>
  <Nav />

  <main>
    <!-- ── Hero ── -->
    <section class="relative overflow-hidden pt-14 pb-10">
      <!-- Ambient blobs -->
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute -top-32 -left-32 w-[520px] h-[520px] rounded-full bg-primary/10 blur-[100px]"></div>
        <div class="absolute top-40 -right-20 w-[400px] h-[400px] rounded-full bg-periwinkle/15 blur-[80px]"></div>
        <div class="absolute bottom-0 left-1/3 w-[260px] h-[260px] rounded-full bg-mint/8 blur-[72px]"></div>
      </div>

      <div class="max-w-6xl mx-auto px-6">
        <div class="flex items-center gap-3 mb-5">
          <div class="h-px w-10 bg-primary/40 flex-shrink-0"></div>
          <span class="text-sm font-medium tracking-widest uppercase text-primary/80">
            Essays &amp; Newsletters
          </span>
        </div>
        <h1 class="font-display text-[clamp(2.6rem,6vw,4.5rem)] leading-[1.06] tracking-tight text-dark">
          Welcome to 'Dino University'
        </h1>
        <p class="mt-4 text-[1.05rem] font-light text-dark/60 max-w-xl">
          Below are my best newsletters, journal entries, and strategies. I'm constantly working to grow my YouTube channel, build a business, and launch projects. So hopefully these resources can help you do those as well.
        </p>
      </div>
    </section>

    <!-- ── Newsletter Cards ── -->
    <section class="py-6 max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

        <!-- Card 1: The Yearbook -->
        <div class="rounded-2xl border border-dark/8 bg-white/60 backdrop-blur-sm px-6 py-5 flex flex-col gap-3 shadow-sm">
          <div class="flex items-center gap-3">
            <div class="h-0.5 w-8 rounded-full bg-gradient-to-r from-primary to-periwinkle flex-shrink-0"></div>
            <h2 class="font-display text-lg text-dark">The Yearbook</h2>
            <span class="ml-auto inline-block px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-primary/10 text-primary tracking-wide whitespace-nowrap">Personal · Life · Creativity</span>
          </div>
          <p class="text-sm font-light text-dark/60 leading-relaxed">
            A monthly newsletter featuring behind-the-scenes updates about my next upload.
          </p>
          <KitForm
            formId="9211740"
            buttonText="Become an Insider"
            buttonStyle="purple"
            instanceId="yearbook-writing-form"
          />
        </div>

        <!-- Card 2: The Notebook -->
        <div class="rounded-2xl border border-dark/8 bg-white/60 backdrop-blur-sm px-6 py-5 flex flex-col gap-3 shadow-sm">
          <div class="flex items-center gap-3">
            <div class="h-0.5 w-8 rounded-full bg-gradient-to-r from-mint to-periwinkle flex-shrink-0"></div>
            <h2 class="font-display text-lg text-dark">The Notebook</h2>
            <span class="ml-auto inline-block px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-mint/20 text-dark/70 tracking-wide whitespace-nowrap">Content · Strategy · Views</span>
          </div>
          <p class="text-sm font-light text-dark/60 leading-relaxed">
            Everything you need to finally get the views you just can't seem to get on your own.
          </p>
          <KitForm
            formId="3880843"
            buttonText="Get It Free"
            buttonStyle="purple"
            placeholder="join 470+ subscribers"
            instanceId="sfs-form"
          />
        </div>
      </div>
    </section>

    <!-- ── Post List ── -->
    <section class="py-16 max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-3 mb-6">
        <div class="h-px w-10 bg-primary/40 flex-shrink-0"></div>
        <span class="text-sm font-medium tracking-widest uppercase text-primary/70">
          All posts
        </span>
      </div>
      <h2 class="font-display text-3xl text-dark mb-8">The archive</h2>

      <!-- Filter Tabs -->
      <div class="flex flex-wrap gap-2 mb-8" id="filter-tabs" role="tablist" aria-label="Filter posts by newsletter">
        {[
          { label: 'All',                value: 'all'               },
          { label: 'The Yearbook',       value: 'The Yearbook'      },
          { label: 'Short Form Secrets', value: 'Short Form Secrets'},
        ].map(tab => (
          <button
            role="tab"
            data-filter={tab.value}
            aria-selected={tab.value === 'all' ? 'true' : 'false'}
            class:list={[
              'filter-tab px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 border',
              tab.value === 'all'
                ? 'bg-primary text-white border-primary'
                : 'bg-white/60 text-dark/60 border-dark/10 hover:border-primary/30 hover:text-dark',
            ]}
          >
            {tab.label}
          </button>
        ))}
      </div>

      <!-- Post Rows -->
      <div id="post-list" class="divide-y divide-dark/6 rounded-2xl border border-dark/8 bg-white/50 overflow-hidden">

        {posts.map(post => {
          const newsletter = post.data.newsletter ?? 'General';
          const pubDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });
          const visibleTags = (post.data.tags ?? []).slice(0, 3);

          return (
            <article
              data-newsletter={newsletter}
              class="post-row group flex items-center gap-4 px-5 py-4 hover:bg-primary/4 transition-colors"
            >
              <span class="text-amber-400 text-sm flex-shrink-0 w-4" aria-label={post.data.featured ? 'Featured' : ''}>
                {post.data.featured ? '★' : ''}
              </span>
              <a
                href={`/writing/${post.slug}`}
                class="flex-1 font-medium text-dark group-hover:text-primary transition-colors text-[0.95rem] leading-snug"
              >
                {post.data.title}
              </a>
              <div class="hidden sm:flex items-center gap-1.5 flex-shrink-0">
                {visibleTags.map(tag => (
                  <span class={`px-2 py-0.5 rounded-full text-[10px] font-medium ${tagColors[tag] ?? 'bg-dark/8 text-dark/55'}`}>
                    {tag}
                  </span>
                ))}
              </div>
              <time class="text-xs text-dark/40 font-medium flex-shrink-0 tabular-nums">{pubDate}</time>
            </article>
          );
        })}

        <!-- No results fallback (hidden by default) -->
        <div id="no-results" class="hidden px-5 py-12 text-center text-sm text-dark/40 font-light">
          No posts in this category yet. Check back soon.
        </div>

      </div>
    </section>

    <script>
      const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
      const rows = document.querySelectorAll<HTMLElement>('.post-row');
      const noResults = document.getElementById('no-results')!;

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const filter = tab.dataset.filter!;

          tabs.forEach(t => {
            const active = t.dataset.filter === filter;
            t.setAttribute('aria-selected', String(active));
            t.classList.toggle('bg-primary', active);
            t.classList.toggle('text-white', active);
            t.classList.toggle('border-primary', active);
            t.classList.toggle('bg-white/60', !active);
            t.classList.toggle('text-dark/60', !active);
            t.classList.toggle('border-dark/10', !active);
          });

          let visible = 0;
          rows.forEach(row => {
            const show = filter === 'all' || row.dataset.newsletter === filter;
            row.style.display = show ? '' : 'none';
            if (show) visible++;
          });

          noResults.classList.toggle('hidden', visible > 0);
        });
      });
    </script>
  </main>

  <Footer />
</Layout>
