---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import KitForm from '../../components/KitForm.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const siteUrl = 'https://dinofavarajr.com';
const articleUrl = `${siteUrl}/writing/${post.slug}`;

const pubDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.headline ?? post.data.title,
  url: articleUrl,
  datePublished: new Date(post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Dino Favara Jr.',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Person',
    name: 'Dino Favara Jr.',
    url: siteUrl,
  },
  keywords: [
    ...(post.data.tags ?? []),
    post.data.newsletter ?? '',
    'Central Florida content creator',
    'YouTube strategy',
  ].filter(Boolean).join(', '),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
};

const categoryColors: Record<string, string> = {
  'Personal Growth': 'bg-periwinkle/20 text-primary',
  'YouTube Strategy': 'bg-mint/20 text-dark/70',
  'Disney': 'bg-primary/10 text-primary',
  'General': 'bg-dark/8 text-dark/60',
};

const newsletterColors: Record<string, string> = {
  'The Yearbook': 'bg-primary/10 text-primary',
  'Short Form Secrets': 'bg-mint/20 text-dark/70',
  'General': 'bg-dark/8 text-dark/60',
};

const categoryColor = post.data.category
  ? (categoryColors[post.data.category] ?? 'bg-dark/8 text-dark/60')
  : 'bg-dark/8 text-dark/60';

const newsletterLabel = post.data.newsletter ?? post.data.category ?? 'Writing';
const newsletterColor = post.data.newsletter
  ? (newsletterColors[post.data.newsletter] ?? 'bg-dark/8 text-dark/60')
  : categoryColor;
---

<Layout
  title={`${post.data.title} | Dino Favara Jr.`}
  description={post.data.headline ?? post.data.title}
  ogType="article"
  canonicalUrl={articleUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  </Fragment>
  <Nav />

  <main>
    <!-- Back link -->
    <section class="max-w-3xl mx-auto px-6 pt-10">
      <a href="/writing" class="inline-flex items-center gap-2 text-sm font-medium text-primary/70 hover:text-primary transition-colors duration-200">
        &larr; All writing
      </a>
    </section>

    <!-- Header -->
    <section class="max-w-3xl mx-auto px-6 pt-8 pb-12">
      <div class="flex flex-wrap items-center gap-2 mb-6">
        <span class={`inline-block px-3 py-1 rounded-full text-xs font-medium tracking-wide ${newsletterColor}`}>
          {newsletterLabel}
        </span>
        <time class="text-xs text-dark/40 font-medium">{pubDate}</time>
      </div>

      <h1 class="font-display leading-[1.05] tracking-tight text-dark mb-4" style="font-size: clamp(2.4rem, 6vw, 4.2rem);">
        {post.data.title}
      </h1>

      {post.data.headline && post.data.headline !== post.data.title && (
        <p class="text-lg font-light text-dark/60 leading-relaxed max-w-xl">
          {post.data.headline}
        </p>
      )}

      <div class="mt-8 h-px w-full bg-dark/8"></div>
    </section>

    <!-- Article Body -->
    <section class="max-w-3xl mx-auto px-6 pb-16">
      <article class="prose-article">
        <Content />
      </article>
    </section>

    <!-- Newsletter CTA -->
    <section class="max-w-3xl mx-auto px-6 pb-20">
      <div class="rounded-2xl border border-dark/8 bg-white/60 p-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="h-px w-10 bg-primary/40 flex-shrink-0"></div>
          <span class="text-sm font-medium tracking-widest uppercase text-primary/70">Newsletter</span>
        </div>
        <h2 class="font-display text-2xl text-dark mb-2">Follow the journey</h2>
        <p class="text-sm font-light text-dark/60 leading-relaxed mb-6">
          The Yearbook is my monthly newsletter — life, creativity, faith, fatherhood, and behind-the-scenes on the channel.
        </p>
        <KitForm
          formId="9211740"
          buttonText="Subscribe"
          buttonStyle="purple"
          instanceId={`article-cta-${post.slug}`}
        />
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .prose-article :global(h2) {
    font-family: 'Instrument Serif', serif;
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--dark);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }
  .prose-article :global(h3) {
    font-family: 'Instrument Serif', serif;
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--dark);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-article :global(p) {
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(26, 21, 35, 0.70);
    margin-bottom: 1.25rem;
  }
  .prose-article :global(strong) {
    font-weight: 500;
    color: var(--dark);
  }
  .prose-article :global(em) {
    font-style: italic;
  }
  .prose-article :global(a) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-article :global(a:hover) {
    opacity: 0.75;
  }
  .prose-article :global(ul),
  .prose-article :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose-article :global(li) {
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.75;
    color: rgba(26, 21, 35, 0.70);
    margin-bottom: 0.4rem;
  }
  .prose-article :global(ul > li) {
    list-style-type: disc;
  }
  .prose-article :global(ol > li) {
    list-style-type: decimal;
  }
  .prose-article :global(blockquote) {
    border-left: 3px solid var(--primary);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    background: rgba(107, 92, 231, 0.04);
    border-radius: 0 0.75rem 0.75rem 0;
  }
  .prose-article :global(blockquote p) {
    font-family: 'Instrument Serif', serif;
    font-size: 1.15rem;
    font-weight: 400;
    font-style: italic;
    color: var(--dark);
    margin-bottom: 0;
  }
  .prose-article :global(hr) {
    border: none;
    border-top: 1px solid rgba(26, 21, 35, 0.08);
    margin: 2rem 0;
  }
  .prose-article :global(h2:first-child),
  .prose-article :global(h3:first-child) {
    margin-top: 0;
  }
</style>
