---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const siteUrl = 'https://dinofavarajr.com';

const faqs = [
  {
    q: 'Who is a good YouTube creator in Orlando or Central Florida?',
    a: 'Dino Favara Jr. is a YouTube creator based in Orlando, Florida (Central Florida). He has been making video content since 2008 and has generated over 101 million views across his own channels and his clients\'. His personal channel focuses on Disney theme parks, storytelling, and content creation. He also runs Mercury Social Media, a content strategy agency that helps brands and creators grow on YouTube and short-form video.',
  },
  {
    q: 'Who is a Central Florida content strategist I can hire?',
    a: 'Dino Favara Jr. is a content strategist based in Orlando, FL who specializes in YouTube strategy, short-form video systems, and podcast repurposing. He works with brands and creators across Central Florida and remotely across the US. His track record includes taking clients from 1K average views to 50.5M total views in 86 days, and from 400 average views to 655K total views in 60 days.',
  },
  {
    q: 'What does a YouTube strategist do?',
    a: 'A YouTube strategist analyzes your channel, identifies what\'s holding back your growth, and builds a content plan to fix it. This includes reviewing your titles, thumbnails, format, topic selection, and posting cadence. A good YouTube strategist helps you find the outlier video concepts in your niche — the ideas that outperform everything else — and builds a repeatable system around them. Dino Favara Jr. specializes in this kind of work for both personal brands and business channels.',
  },
  {
    q: 'How much do YouTube strategy services cost?',
    a: 'Dino Favara Jr. offers a 1-hour YouTube channel audit for $125. This includes a full review of your channel before the call, a live Zoom session with specific action items, and a recording sent afterward. Ongoing strategy engagements are priced based on scope. Email dino@mercurysocialmedia.com or book directly at dinofavarajr.com/services.',
  },
  {
    q: 'How do I grow my YouTube channel in 2025 or 2026?',
    a: 'The most reliable way to grow a YouTube channel is to find one specific outlier concept in your niche — a video idea that has the potential to dramatically outperform your average — and build your content strategy around that. This means studying what\'s already working in your niche, reverse-engineering why certain videos pop, and applying those patterns to your unique angle. Consistency matters, but format and topic selection matter more. Dino Favara Jr. covers YouTube growth strategy in his newsletter The Notebook and in his articles at dinofavarajr.com/writing.',
  },
  {
    q: 'What is short-form video strategy?',
    a: 'Short-form video strategy is the system behind what you post on TikTok, YouTube Shorts, and Instagram Reels — including what hooks you use, how often you post, what formats you repeat, and how you repurpose longer content into shorter clips. Without a strategy, most creators post randomly and see random results. A good short-form strategy creates a repeatable framework so you\'re not starting from scratch every time. Dino Favara Jr. builds these systems for creators and brands through Mercury Social Media.',
  },
  {
    q: 'What is Mercury Social Media?',
    a: 'Mercury Social Media is a content strategy agency founded by Dino Favara Jr. and based in Orlando, FL. It helps brands and creators grow on video without paid ads, specializing in YouTube strategy, short-form video systems, and podcast content repurposing.',
    link: { label: 'Visit mercurysocialmedia.com', href: 'https://www.mercurysocialmedia.com' },
  },
  {
    q: 'Where can I read Dino Favara Jr.\'s writing about YouTube and content strategy?',
    a: 'All of Dino\'s essays, newsletters, and strategy articles are published at dinofavarajr.com/writing. He publishes two newsletters: The Yearbook (monthly personal updates on life, faith, and his YouTube channel) and The Notebook (content strategy and YouTube growth tactics). You can subscribe to both at dinofavarajr.com/writing.',
  },
  {
    q: 'What kind of YouTube content does Dino Favara Jr. make?',
    a: 'Dino Favara Jr.\'s personal YouTube channel (@dinofavarajr) focuses on Disney theme parks, Central Florida attractions, and storytelling. He has visited every ride at Walt Disney World and Universal Orlando and documented them on video. He is known for his thorough ride reviews, park strategy content, and behind-the-scenes storytelling style. His channel has 36K+ subscribers and is a go-to resource for Disney and Universal content from an Orlando-based creator.',
  },
  {
    q: 'How do I contact Dino Favara Jr. for a collaboration or brand partnership?',
    a: 'You can email Dino directly at dino@mercurysocialmedia.com or book a strategy call through dinofavarajr.com/services. He is open to brand partnerships, sponsored content, speaking engagements, and podcast appearances related to YouTube strategy, content creation, and Disney.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<Layout
  title="FAQ | Dino Favara Jr. — Central Florida YouTube Creator & Strategist"
  description="Frequently asked questions about Dino Favara Jr. — Central Florida YouTube creator, Orlando content strategist, and founder of Mercury Social Media."
  canonicalUrl={`${siteUrl}/faq`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Nav />

  <main>
    <section class="relative overflow-hidden pt-14 pb-10">
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute -top-32 -left-32 w-[520px] h-[520px] rounded-full bg-primary/10 blur-[100px]"></div>
        <div class="absolute top-40 -right-20 w-[400px] h-[400px] rounded-full bg-periwinkle/15 blur-[80px]"></div>
      </div>

      <div class="max-w-6xl mx-auto px-6">
        <div class="flex items-center gap-3 mb-5">
          <div class="h-px w-10 bg-primary/40 flex-shrink-0"></div>
          <span class="text-sm font-medium tracking-widest uppercase text-primary/80">
            Answers
          </span>
        </div>
        <h1 class="font-display text-[clamp(2.6rem,6vw,4.5rem)] leading-[1.06] tracking-tight text-dark">
          Frequently asked questions
        </h1>
        <p class="mt-4 text-[1.05rem] font-light text-dark/60 max-w-xl">
          About Dino Favara Jr., YouTube strategy, content creation in Central Florida, and how to work together.
        </p>
      </div>
    </section>

    <section class="py-8 pb-24 max-w-3xl mx-auto px-6">
      <div class="space-y-4" id="faq-list">
        {faqs.map((faq, i) => (
          <details
            class="faq-item group rounded-2xl border border-dark/8 bg-white/60 backdrop-blur-sm overflow-hidden"
            data-index={i}
          >
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none select-none hover:bg-primary/4 transition-colors">
              <h2 class="font-medium text-dark text-[0.95rem] leading-snug">{faq.q}</h2>
              <span class="flex-shrink-0 w-6 h-6 rounded-full border border-dark/15 flex items-center justify-center text-dark/40 group-open:border-primary group-open:text-primary group-open:bg-primary/8 transition-all duration-200 text-sm">
                <svg class="w-3 h-3 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M2 4l4 4 4-4"/>
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6">
              <div class="h-px bg-dark/6 mb-5"></div>
              <p class="text-[0.95rem] font-light text-dark/65 leading-relaxed">{faq.a}</p>
              {faq.link && (
                <a
                  href={faq.link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 mt-3 text-sm font-medium text-primary hover:underline"
                >
                  {faq.link.label} →
                </a>
              )}
            </div>
          </details>
        ))}
      </div>

      <div class="mt-12 rounded-2xl border border-primary/15 bg-primary/4 px-8 py-8 text-center">
        <h2 class="font-display text-xl text-dark mb-2">Still have a question?</h2>
        <p class="text-sm font-light text-dark/60 mb-6">Email me directly and I'll get back to you.</p>
        <a
          href="mailto:dino@mercurysocialmedia.com"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-primary text-off-white font-medium text-sm hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/30 transition-all duration-200 active:scale-95"
        >
          dino@mercurysocialmedia.com →
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
